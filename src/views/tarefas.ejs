<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minhas Tarefas | TaskFlow</title>

    <link rel="stylesheet" href="/css/styles.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>

<body>

<header>
    <div class="inner">

        <h1>📋 TaskFlow</h1>

        <nav>

            <span class="user">
                👤 <%= nome %>
            </span>

            <a href="/logout" class="logout-link">
                Sair
            </a>

        </nav>

    </div>
</header>

<div class="container">

    <% if (flash) { %>
        <div class="flash">
            <%= flash %>
        </div>
    <% } %>

    <div class="card">

        <h2>➕ Nova Tarefa</h2>

        <form
            method="POST"
            action="/tarefas"
            class="task-form"
        >

            <input
                type="text"
                name="texto"
                placeholder="O que você precisa fazer?"
                required
            >

            <button
                type="submit"
                class="btn btn-primary"
            >
                Adicionar
            </button>

        </form>

    </div>

    <div class="card">

        <h2>
            📋 Minhas Tarefas
            (<%= tarefas.length %>)
        </h2>

        <% if (tarefas.length === 0) { %>

            <div class="empty-state">

                <h3>Nenhuma tarefa cadastrada</h3>

                <p>
                    Adicione sua primeira tarefa acima.
                </p>

            </div>

        <% } else { %>

            <div class="task-list">

                <% tarefas.forEach(t => { %>

                    <div class="task-item">

                        <form
                            method="POST"
                            action="/tarefas/<%= t.id %>/concluir"
                        >

                            <button
                                type="submit"
                                class="check-btn"
                            >
                                <%= t.concluida ? "✓" : "" %>
                            </button>

                        </form>

                        <div class="task-content">

                            <span
                                class="<%= t.concluida ? 'task-done' : 'task-text' %>"
                            >
                                <%= t.texto %>
                            </span>

                            <small class="task-date">
                                <%= t.criadaEm %>
                            </small>

                        </div>

                        <form
                            method="POST"
                            action="/tarefas/<%= t.id %>/remover"
                        >

                            <button
                                type="submit"
                                class="delete-btn"
                            >
                                🗑️
                            </button>

                        </form>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</div>

</body>
</html>